{
  "name": "@easbot/ui",
  "version": "0.3.31",
  "description": "EASBot UI — A React component library built on Radix UI + Tailwind CSS, with 56 ready-to-use accessible components.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./iconfont.css": "./dist/iconfont.css",
    "./theme-light.css": "./dist/theme-light.css",
    "./theme-dark.css": "./dist/theme-dark.css",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup && pnpm build:css && pnpm build:fonts && pnpm build:icons",
    "build:css": "tailwindcss -i ./src/theme/styles.css -o ./dist/styles.css --minify",
    "build:fonts": "tsx scripts/build-fonts.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:report": "biome check --reporter=summary .",
    "format": "biome format . && prettier --check --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "format:fix": "biome format --write . && prettier --write --no-error-on-unmatched-pattern \"**/*.md\" \"**/*.mdx\"",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "check:i18n": "tsx spec/scripts/check-i18n.ts",
    "check:spec": "tsx spec/scripts/check-spec.ts",
    "probe": "tsx spec/scripts/probe.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "version:pre-commit": "tsx scripts/pre-commit-version.ts",
    "version:patch": "tsx scripts/bump-version.ts patch",
    "version:minor": "tsx scripts/bump-version.ts minor",
    "version:major": "tsx scripts/bump-version.ts major",
    "publish:npm": "bash scripts/publish.sh",
    "publish:npm:win": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1",
    "publish:list": "tsx ./scripts/list-published-versions.ts"
  },
  "keywords": [
    "react",
    "radix-ui",
    "tailwindcss",
    "component-library",
    "ui",
    "design-system",
    "easbot"
  ],
  "author": "houjallen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/houjallen/easbot-ui.git"
  },
  "homepage": "https://github.com/houjallen/easbot-ui",
  "bugs": "https://github.com/houjallen/easbot-ui/issues",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
